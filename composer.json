{
  "name": "kevind3v/brlayer",
  "description": "Camada de persistência com PDO e prepared statements: model Active Record com CRUD, consultas encadeadas e SQL próprio seguro.",
  "keywords": [
    "BrLayer",
    "DataLayer",
    "Database",
    "PDO",
    "Active Record",
    "CRUD"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Kevin Siqueira",
      "role": "Maintainer"
    },
    {
      "name": "Robson V. Leite",
      "email": "cursos@upinside.com.br",
      "role": "Original author (CoffeeCode DataLayer)"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "BrLayer\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BrLayer\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
